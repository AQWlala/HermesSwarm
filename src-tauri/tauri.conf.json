{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "",
    "devPath": "http://localhost:5173",
    "beforeBuildCommand": "",
    "distDir": "../src/ui/dist"
  },
  "package": {
    "productName": "HermesSwarm",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "com.hermesswarm.app",
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [],
      "externalBin": ["bin/hermesswarm-backend"]
    },
    "windows": [
      {
        "title": "HermesSwarm - 可视化智能体编排平台",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "allowlist": {
      "shell": {
        "sidecar": true,
        "execute": true
      }
    }
  }
}
